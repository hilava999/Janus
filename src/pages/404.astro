---
import { getEntry} from 'astro:content';

import SeoHead from '../components/SeoHead.astro';

import '../css/reset.css';
import '../css/base.css';

// 3. サイト設定 (settings) を取得
const settingsEntry = await getEntry('settings', 'index'); // または 'profile'
const settings = settingsEntry?.data;

const accentColor = settings?.theme?.accent_color || '#4a90e2';
const fontFamily = settings?.theme?.font === 'serif' 
  ? "'Shippori Mincho', serif"
  : "'Noto Sans JP', sans-serif";

const pageTitle = "404";
const pageDesc = "お探しのページは見つかりませんでした。";

---

<html lang="ja">
  <head>
    <SeoHead title={pageTitle} description={pageDesc} image={settings?.ogImage} type="article"/>
    <link rel="icon" type="image/svg+xml" href={settings?.favicon || '/favicon.svg'} />
  </head>

  <body style={`--accent: ${accentColor}; font-family: ${fontFamily};`}>
    <div class="wrapper">
      <header class="header">
        <a href="/"><h1 class="page-top">{settings?.siteTitle || 'サイト名'}</h1></a>
      </header>
      <div class="container404">
        <h1>404</h1>
        <p>
            お探しのページは見つかりませんでした。<br><br>
            <a href="/" class="btn">Home</a>
        </p>
      </div>
    </div>
  </body>
</html>

<style>
    .container404 {
        width: 85%;
        max-width: 500px;
        border: 1px solid #666;
        padding: 2rem 4rem;
        margin: 3rem auto;
    }

    .btn {
        text-align: center;
        border: #444 1px solid;
        padding: 5px 10px;
    }

    .btn:hover {
        background-color: #444;
        color: #fff;
    }
</style>