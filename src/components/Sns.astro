---
import { getEntry } from 'astro:content';
import { Icon } from "astro-icon/components";

// 1. サイト設定 (settings) を取得（タイトルやテーマカラー用）
const settingsEntry = await getEntry('settings', 'index');
const settings = settingsEntry?.data;

const accentColor = settings?.theme?.accent_color || '#4a90e2';
const fontFamily = settings?.theme?.font === 'serif' 
  ? "'Shippori Mincho', serif"
  : "'Noto Sans JP', sans-serif";

// SNS配列を取得（データがない場合の安全対策として空配列を入れておく）
const snsLinks = settings?.sns || []; //
---

 {snsLinks.length > 0 && (
        <div class="sns-container" style={`--accent: ${accentColor}; font-family: ${fontFamily};`}>
            {snsLinks.map((sns) => (
                <a 
                    href={sns.url} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class={`sns-link is-${sns.platform}`}
                    title={sns.platform}
                >
                    {/* プラットフォーム名に応じてアイコンを出し分ける */}
                    {sns.platform === 'x' && <Icon name="simple-icons:x" />}
                    {sns.platform === 'bluesky' &&<Icon name="simple-icons:bluesky" />}
                    {sns.platform === 'pixiv' && <Icon name="simple-icons:pixiv" />}
                    {sns.platform === 'github' && <Icon name="simple-icons:github" />}
                    {sns.platform === 'youtube' && <Icon name="simple-icons:youtube" />}
                </a>
            ))}
        </div>
    )}

<style>
    .sns-container {
        margin: 25px 0 10px;
        text-align: right;
        padding: 0 20px;
    }

    .sns-container a svg:hover {
        color: var(--accent);
    }

    [data-icon]{
        font-size: 1.5rem;
        margin-left: 10px;
    }
</style>